# StudentDays Backend Environment Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://studentdays:studentdays_dev_password@localhost:5432/studentdays_dev?schema=public"

# Authentication & Security Secrets (Development only)
JWT_SECRET=studentdays_dev_super_secret_jwt_key_2026_dev_only
JWT_REFRESH_SECRET=studentdays_dev_super_secret_refresh_jwt_key_2026_dev_only
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Modes
PAYMENT_MODE=mock
STORAGE_MODE=local

# Local File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# CORS Allowed Origins
FRONTEND_URL=http://localhost:5173

# Demo Admin Seed Credentials
INITIAL_ADMIN_EMAIL=admin@studentdays.co
INITIAL_ADMIN_PASSWORD=AdminStudentDays2026!
INITIAL_ADMIN_NAME="Dev Master Admin"

INITIAL_COORDINATOR_EMAIL=coordinator@studentdays.co
INITIAL_COORDINATOR_PASSWORD=CoordStudentDays2026!
INITIAL_COORDINATOR_NAME="Ananya Verma"

INITIAL_STUDENT_EMAIL=student@studentdays.co
INITIAL_STUDENT_PASSWORD=StudentDays2026!
INITIAL_STUDENT_NAME="Rohan Sharma"
